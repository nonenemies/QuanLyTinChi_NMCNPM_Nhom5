<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="app-page" stylesheets="@../css/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.RegistrationFailureController">
    <padding><Insets bottom="22.0" left="24.0" right="24.0" top="22.0" /></padding>
    <Label text="Đăng ký không thành công" styleClass="section-title" />
    <Label fx:id="lblHeader" styleClass="registration-subtitle" wrapText="true" />
    <Label fx:id="lblMessage" styleClass="registration-message-error" wrapText="true" />
    <HBox alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnClose" onAction="#onClose"
                styleClass="login-button" text="Đóng" />
    </HBox>
</VBox>
